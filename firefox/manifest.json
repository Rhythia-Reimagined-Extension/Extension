{
  "manifest_version": 3,
  "name": "Reimagined for Rhythia",
  "version": "1.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "shurieldev@gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent",
          "personallyIdentifyingInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "description": "Make your Rhythia profile easier to read, customize, and explore",
  "action": {
    "default_title": "Reimagined for Rhythia",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "background": {
    "scripts": [
      "shared/time.js",
      "shared/data/data-schema.js",
      "shared/data/data-migrations.js",
      "shared/data/data-repository.js",
      "shared/data/storage-mutation-bridge.js",
      "shared/data/storage-mutation-authority.js",
      "engines.js",
      "background.js"
    ]
  },
  "host_permissions": [
    "https://www.rhythia.com/*",
    "https://rhythia.com/*",
    "https://rhythia.shuriel.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
