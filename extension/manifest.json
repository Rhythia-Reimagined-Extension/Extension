{
  "manifest_version": 3,
  "name": "Reimagined for Rhythia",
  "version": "1.6.0",
  "minimum_chrome_version": "116",
  "description": "Make Rhythia easier to read and explore, with two looks, your own themes, player comparisons and a map search",
  "action": {
    "default_title": "Reimagined for Rhythia",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.rhythia.com/*",
    "https://rhythia.com/*",
    "https://rhythia.shuriel.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
